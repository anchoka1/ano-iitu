# =====================================================================
#  Настройки «Вердикта». Скопируйте этот файл в .env (скрипты run.*
#  делают это сами при первом запуске) и меняйте значения в .env.
#  Файл .env НЕ попадает в git — там будут секреты.
#  После изменения .env перезапустите сервер.
# =====================================================================

# --- Главное: ключи ---------------------------------------------------
# Какая языковая модель проверяет сообщения:
#   gemini     — Google Gemini, БЕСПЛАТНЫЙ тариф (рекомендуется). Ключ: https://aistudio.google.com/apikey
#   groq       — Groq, бесплатный тариф, очень быстрый.          Ключ: https://console.groq.com/keys
#   openrouter — OpenRouter, бесплатные модели «:free».           Ключ: https://openrouter.ai/keys
#   openai     — любой OpenAI-совместимый сервис (укажите LLM_BASE_URL)
#   ollama     — локальная модель на компьютере (нужно 16+ ГБ памяти, иначе медленно)
#   anthropic  — Claude, платно (ANTHROPIC_API_KEY)
LLM_PROVIDER=gemini
# Ключ для gemini / groq / openrouter / openai. Пусто — демо-режим без ИИ.
LLM_API_KEY=
# Модель. Пусто — по умолчанию: gemini-flash-latest (запасная gemini-flash-lite-latest) / openai/gpt-oss-120b (фото — qwen/qwen3.8-27b) / meta-llama/llama-3.3-70b-instruct:free
# Если укажете свою модель — запасная не используется. Пример: LLM_MODEL=gemini-flash-lite-latest (больше бесплатных запросов, чуть проще)
LLM_MODEL=
# Только для LLM_PROVIDER=openai: адрес API, например https://api.example.com/v1
LLM_BASE_URL=

# Токен бота от @BotFather (выглядит как 123456789:AAE...).
# Пусто — бот не запускается, работают только API и Mini App.
TELEGRAM_BOT_TOKEN=

# --- Режимы работы ---------------------------------------------------
# auto  — демо, пока нет ключа ИИ; с ключом — настоящий ИИ (рекомендуется)
# true  — всегда демо, даже с ключом (бесплатно, для показа интерфейса)
# false — всегда настоящий ИИ
MOCK_LLM=auto

# Режим разработки: Mini App можно открыть в обычном браузере
# (http://localhost:8000) без подписи Telegram. Работает ТОЛЬКО для
# запросов с этого же компьютера (не через туннель). На сервере — false!
DEV_MODE=true

# --- Сервер ----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Уровень подробности логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Telegram Mini App -----------------------------------------------
# Бесплатный HTTPS-туннель Cloudflare для Mini App в Telegram:
# cloudflare — при запуске сервер сам поднимет туннель, подставит адрес
# в WEBAPP_URL и поставит кнопку меню бота. Пусто — без туннеля.
TUNNEL=cloudflare
# Публичный HTTPS-адрес Mini App (из Cloudflare Tunnel или ngrok),
# например https://abc-def.trycloudflare.com. Нужен, чтобы открыть
# Mini App внутри Telegram. Пусто — бот покажет подсказку.
WEBAPP_URL=
# Короткое имя Mini App из @BotFather (/newapp) — для ссылок в группах
# вида t.me/имя_бота/КОРОТКОЕ_ИМЯ?startapp=... Можно оставить пустым.
WEBAPP_SHORT_NAME=
# Сколько секунд подпись initData считается свежей (по умолчанию сутки).
INITDATA_MAX_AGE_SECONDS=86400

# --- Языковая модель: дополнительно ---------------------------------
# Claude (платно): ключ и модель, если LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Глубина «размышлений»: low (быстрее, дешевле) | medium | high (точнее, дольше)
LLM_EFFORT=medium
# Ollama — локальная модель без интернета (на русском качество заметно ниже)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Дневной лимит токенов ИИ на одного пользователя
LLM_DAILY_TOKENS_PER_USER=200000

# --- Лимиты (антиспам) -----------------------------------------------
CHECKS_PER_MINUTE=6
CHECKS_PER_DAY=100

# --- Анализ ссылок ---------------------------------------------------
# Узнавать возраст домена через реестр RDAP (саму ссылку НЕ открываем).
LINK_CHECK_ONLINE=true

# --- Расписание ------------------------------------------------------
TIMEZONE=Asia/Almaty
# Индекс чата: день недели (0=пн ... 6=вс) и час
WEEKLY_INDEX_WEEKDAY=6
WEEKLY_INDEX_HOUR=19
SCHEDULER_ENABLED=true

# --- Университет (МУИТ / IITU) ---------------------------------------
# Лента новостей: официальный сайт и официальный Telegram-канал МУИТ.
NEWS_ENABLED=true
NEWS_SITE_URL=https://iitu.edu.kz/ru/news/
NEWS_TELEGRAM_CHANNEL=iitu_channel
# Как часто обновлять ленту (минуты). Пока источник недоступен — показываем кэш.
NEWS_REFRESH_MINUTES=60
# Сколько новых новостей пересказывать ИИ за одно обновление (экономит лимиты).
NEWS_SUMMARY_PER_RUN=4
# Максимум уведомлений подписчикам о новых новостях за одно обновление.
NEWS_NOTIFY_MAX=3
# За сколько дней напоминать о событиях академического календаря.
CALENDAR_REMIND_DAYS=2

# --- База данных -----------------------------------------------------
# Путь к файлу SQLite (относительно папки проекта). Создаётся сам.
DATABASE_URL=sqlite:///data/verdikt.db

# --- Роли и модерация ------------------------------------------------
# Telegram id через запятую. Свой id бот подскажет командой /myid.
# Админ: модерирует и назначает модераторов (в приложении: Профиль → Модерация → Модераторы, или /grant ID).
# Без админа и модераторов заявки в Радар и вопросы в IITU Hub никто не одобрит.
ADMIN_IDS=
# Модераторы: очередь в приложении (Профиль → Модерация), кнопки в чате модераторов, /mod.
MODERATOR_IDS=
# Служебный чат модераторов (id группы, начинается с -100; узнать — /myid в этом чате).
# Пусто — заявки приходят каждому модератору в личку.
MOD_CHAT_ID=
# Старое имя для админов (работает как ADMIN_IDS).
OWNER_IDS=

# --- Поиск в интернете для «Правды» -----------------------------------
# tavily (рекомендуется, 1000 бесплатных запросов в месяц: https://app.tavily.com) | brave | ddg (без ключа) | groq | off.
# Пусто — сам: есть SEARCH_API_KEY → tavily; иначе DuckDuckGo без ключа (без дат публикации).
# groq — встроенный поиск Groq: на бесплатном тарифе съедает суточный лимит токенов за пару проверок.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Файлы и личные данные --------------------------------------------
# Ключ шифрования файлов и чувствительных полей. Пусто — сервер создаст его при первом запуске и допишет сюда.
# Потеряете ключ — зашифрованные файлы не прочитать. Не публикуйте.
DATA_ENCRYPTION_KEY=
# Максимальный размер загружаемого файла (МБ).
MAX_UPLOAD_MB=10
# Сколько дней хранить загруженные фото к объявлениям (потом удаляются автоматически).
FILE_RETENTION_DAYS=30
# Общий лимит запросов к API от одного человека в минуту.
API_REQUESTS_PER_MINUTE=120

# --- Новые функции: планер, опросы, учебные хабы, сообщество ------
# «Соль» для анонимных ответов (хеш вместо id). Пусто — сгенерируется при первом
# запуске и сохранится в базе. Задайте свою длинную случайную строку и не меняйте её.
ANON_SALT=
# Результаты анонимных опросов скрыты, пока ответов меньше этого числа.
ANON_MIN_ANSWERS=5
# Слух недели: день недели (0=пн) и час рассылки подписчикам; сколько разных людей
# должны были проверить слух, чтобы он попал в «Слух недели».
RUMOR_WEEKDAY=0
RUMOR_HOUR=12
RUMOR_MIN_USERS=2
# Утренняя сводка и «Лягушка дня» — час рассылки подписчикам.
MORNING_HOUR=8
# Светофор недели (по умолчанию пятница 18:00) и «Вердикт недели» (воскресенье 20:00).
TRAFFIC_WEEKDAY=4
TRAFFIC_HOUR=18
WEEK_VERDICT_WEEKDAY=6
WEEK_VERDICT_HOUR=20
# Пульс МУИТ: новый вопрос недели (по умолчанию вторник 12:00).
PULSE_WEEKDAY=1
PULSE_HOUR=12

# --- Флаги функций: false — функция спрятана (экран, команды и API), код не трогаем ---
# Планер «Мой план»
# Планер и трекер задач
FEATURE_PLANNER=true
# Лягушка дня
FEATURE_PLANNER_FROG=true
# Матрица «срочно / важно»
FEATURE_PLANNER_MATRIX=true
# Разбей на шаги
FEATURE_PLANNER_STEPS=true
# Светофор недели
FEATURE_PLANNER_TRAFFIC=true
# Договор с собой и свидетель
FEATURE_PLANNER_PROMISE=true
# Вердикт недели
FEATURE_PLANNER_WEEK_VERDICT=true
# Командная доска
FEATURE_PLANNER_TEAM_BOARD=true
# Волна 1
# Слух недели
FEATURE_RUMOR_WEEK=true
# Слухи и факты: проверка слухов модератором
FEATURE_FACT_FEED=true
# GPA-калькулятор
FEATURE_GPA=true
# Обратный отсчёт
FEATURE_COUNTDOWN=true
# Дедлайны из «Договорились»
FEATURE_AGREEMENT_DEADLINES=true
# Разбор силлабуса
FEATURE_SYLLABUS=true
# Опрос после пары
FEATURE_CLASS_POLL=true
# Волна 2
# Пульс МУИТ
FEATURE_PULSE=true
# Спроси старшекурсника
FEATURE_ASK_SENIOR=true
# Мой курс: чек-лист
FEATURE_CHECKLIST=true
# Утренняя сводка
FEATURE_MORNING_DIGEST=true
# Помощник обращений
FEATURE_APPEAL_HELPER=true
# Радар разводов
FEATURE_SCAM_RADAR=true
# Правила ИИ на курсе
FEATURE_AI_RULES=true
# Вопросы перед лекцией
FEATURE_LECTURE_QUESTIONS=true
# Запись на консультацию
FEATURE_CONSULTATIONS=true
# Отчёт по договорённости
FEATURE_AGREEMENT_REPORT=true
# Пульс группы
FEATURE_GROUP_PULSE=true
# Волна 3
# Рейтинг групп
FEATURE_GROUP_RATING=true
# Поиск команды
FEATURE_TEAM_SEARCH=true
# Потеряшки
FEATURE_LOST_FOUND=true
# Афиша и клубы
FEATURE_EVENTS=true
# Фокус-комната
FEATURE_FOCUS_ROOM=true
# Квиз первокурсника
FEATURE_QUIZ=true
# Отзывы о предметах
FEATURE_SUBJECT_REVIEWS=true
# Карьерный трек
FEATURE_CAREER=true
# Полка ресурсов
FEATURE_RESOURCES=true
# Капсула времени
FEATURE_TIME_CAPSULE=true
# Значки
FEATURE_BADGES=true
# Учебные хабы
# Каталог учебных хабов
FEATURE_HUBS=true
# Бот в группах с темами
FEATURE_HUB_TOPICS=true
# «Сохрани ответ» и повторные вопросы
FEATURE_HUB_FAQ=true
# Дайджест темы
FEATURE_HUB_DIGEST=true
# Менторы
FEATURE_MENTORS=true
# Кабинет дисциплины и «Ответ преподавателя»
FEATURE_TEACHER_CABINET=true
# Преподавательская
FEATURE_TEACHERS_ROOM=true
# План курса и карта нагрузки
FEATURE_COURSE_PLAN=true
